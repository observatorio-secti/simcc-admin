DATABASE_URL="postgresql+psycopg://db_user:db_password@localhost:5432/db"
SECRET_KEY="your-very-secret-and-exclusive-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL de destino no seu Frontend (SPA)
FRONTEND_AUTH_CALLBACK_URL="http://localhost:3000/auth/callback"

# Google OAuth (Console Cloud -> Credentials -> OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# ORCID OAuth (Sandbox ou Produção)
ORCID_CLIENT_ID="APP-SEU-ORCID-CLIENT-ID"
ORCID_CLIENT_SECRET="seu-orcid-client-secret"
ORCID_REDIRECT_URI="http://localhost:8000/auth/orcid/callback"
ORCID_SANDBOX=true

# Administrador Inicial Padrão (Bootstrap)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@simcc.org"
ADMIN_PASSWORD="admin_secret_password"

