ADMIN_PORT_DB=5432
ADMIN_API_PORT=8009
COMPOSE_PROJECT_NAME=simcc
ADMIN_DATABASE_URL="postgresql+psycopg://db_user:db_password@localhost:5432/db"

# Token de serviço interno (Machine-to-Machine) para rotas protegidas (ex.: extração parquet pelo simcc-etl)
ADMIN_SERVICE_TOKEN="change-this-in-production-service-token"

# Observatório IdP (Validação Stateless RS256 via JWKS ou Chave Pública PEM)
IDP_ISSUER="https://observatoriocti.secti.ba.gov.br/idp"
IDP_JWKS_URL="https://observatoriocti.secti.ba.gov.br/idp/.well-known/jwks.json"
